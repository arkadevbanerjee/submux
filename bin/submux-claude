#!/bin/sh
# submux-claude — launch Claude Code through a local submux relay so its
# four subagent tiers can each be pinned to a different id.
#
#   submux-claude --fable <id> --opus <id> --sonnet <id> --haiku <id> \
#                  [--effort LEVEL] [--port N] [-- <claude args>]
#   submux-claude --last | --profile NAME [-- <claude args>]   # saved setup, no picker
#
# Every --fable/--opus/--sonnet/--haiku flag is optional: an omitted tier is
# left unset so Claude Code falls back to its own default for that tier.
# The four ids are never hardcoded here or in the Go binary; they are chosen
# at launch time only.
set -eu

PORT=8787
FABLE_ID=""
OPUS_ID=""
SONNET_ID=""
HAIKU_ID=""
MAIN_ID=""
EFFORT=""

# No tier flags at all means the flags-typing path is skipped entirely in
# favor of the interactive picker (`submux pick`, spec §2.7): recorded
# BEFORE the flag loop below, since that loop consumes $@.
PICK_IF_NO_FLAGS=1
PROFILE=""
for arg in "$@"; do
  case "$arg" in
    --) break ;;
    --effort) ;; # explicit --effort does not skip the picker
    --fable|--opus|--sonnet|--haiku|--last|--profile) PICK_IF_NO_FLAGS=0 ;;
  esac
done

while [ $# -gt 0 ]; do
  case "$1" in
    --last) PROFILE="--last"; shift ;;
    --profile) PROFILE="$2"; shift 2 ;;
    --fable) FABLE_ID="$2"; shift 2 ;;
    --opus) OPUS_ID="$2"; shift 2 ;;
    --sonnet) SONNET_ID="$2"; shift 2 ;;
    --haiku) HAIKU_ID="$2"; shift 2 ;;
    --effort) EFFORT="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "submux-claude: unknown argument: $1" >&2; exit 64 ;;
  esac
done

# Optional user hook, run before the picker so it sees any catalogue changes
# the hook makes (e.g. syncing a proxy's model list). Its failure never
# blocks a launch.
PRELAUNCH="${XDG_CONFIG_HOME:-$HOME/.config}/submux/prelaunch"
if [ -x "$PRELAUNCH" ]; then
  "$PRELAUNCH" || echo "submux-claude: $PRELAUNCH exited non-zero; launching anyway" >&2
fi

# The interactive picker: only when none of --fable/--opus/--sonnet/--haiku
# was passed. Explicit-flags callers (scripts) get byte-for-byte today's
# behaviour below, untouched.
if [ "$PICK_IF_NO_FLAGS" -eq 1 ]; then
  if ! command -v submux >/dev/null 2>&1; then
    echo "submux-claude: no 'submux' binary on PATH; build it with 'go build -o /path/on/PATH/submux .' first" >&2
    exit 1
  fi
  PICK_OUT="$(mktemp)"
  trap 'rm -f "$PICK_OUT"' EXIT INT TERM
  if ! submux pick --out "$PICK_OUT"; then
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$PICK_OUT"
  MAIN_ID="${SUBMUX_MAIN:-}"
  FABLE_ID="${SUBMUX_FABLE:-}"
  OPUS_ID="${SUBMUX_OPUS:-}"
  SONNET_ID="${SUBMUX_SONNET:-}"
  HAIKU_ID="${SUBMUX_HAIKU:-}"
  EFFORT="${EFFORT:-${SUBMUX_EFFORT:-}}"
fi

# Fast path: --last (most recently used) or --profile NAME loads a saved setup
# from profiles.json directly, no picker. Explicit tier flags still win.
if [ -n "$PROFILE" ]; then
  PROFILES="${XDG_CONFIG_HOME:-$HOME/.config}/submux/profiles.json"
  if [ "$PROFILE" = "--last" ]; then
    SEL='.profiles | sort_by(.last_used) | last'
  else
    SEL='.profiles[] | select(.name == $n)'
  fi
  P="$(jq -c --arg n "$PROFILE" "$SEL" "$PROFILES" 2>/dev/null || true)"
  if [ -z "$P" ] || [ "$P" = "null" ]; then
    echo "submux-claude: no saved profile ${PROFILE#--} in $PROFILES" >&2
    exit 1
  fi
  pf() { printf '%s' "$P" | jq -r --arg k "$1" '.[$k] // ""'; }
  MAIN_ID="$(pf main)"
  FABLE_ID="${FABLE_ID:-$(pf fable)}"
  OPUS_ID="${OPUS_ID:-$(pf opus)}"
  SONNET_ID="${SONNET_ID:-$(pf sonnet)}"
  HAIKU_ID="${HAIKU_ID:-$(pf haiku)}"
  EFFORT="${EFFORT:-$(pf effort)}"
fi

# Claude Code names a model by parsing its id and only knows dashed versions:
# "kiro/claude-opus-5.5" shows as "Opus 5". Hand Claude the dashed form when a
# route's model_rewrite maps it back to the exact id picked; otherwise the id
# passes through untouched.
SUBMUX_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/submux/config.json"
claude_id() {
  dashed="$(printf '%s' "$1" | sed 's/\(claude-[a-z]*-[0-9]*\)\.\([0-9]*\)/\1-\2/')"
  if [ "$dashed" != "$1" ] && [ -r "$SUBMUX_CONFIG" ] && command -v jq >/dev/null 2>&1 &&
    jq -e --arg d "$dashed" --arg o "$1" 'any(.routes[]?; .model_rewrite[$d]? == $o)' "$SUBMUX_CONFIG" >/dev/null 2>&1; then
    printf '%s' "$dashed"
  else
    printf '%s' "$1"
  fi
}
[ -n "$MAIN_ID" ] && MAIN_ID="$(claude_id "$MAIN_ID")"
[ -n "$FABLE_ID" ] && FABLE_ID="$(claude_id "$FABLE_ID")"
[ -n "$OPUS_ID" ] && OPUS_ID="$(claude_id "$OPUS_ID")"
[ -n "$SONNET_ID" ] && SONNET_ID="$(claude_id "$SONNET_ID")"
[ -n "$HAIKU_ID" ] && HAIKU_ID="$(claude_id "$HAIKU_ID")"

# Step 1: the OAuth bearer this whole tool depends on only appears when
# BOTH of these are unset (see README "Mechanism"); either one suppresses
# it silently, so unset both and say so if we changed anything.
if [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
  echo "submux-claude: unsetting ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN: either one suppresses the CLI's own subscription OAuth bearer that passthrough routing depends on" >&2
fi
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN || true

# Step 2: start submux serve if nothing is already listening on $PORT.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/submux"
LOG_FILE="$STATE_DIR/submux.log"
mkdir -p "$STATE_DIR"

if ! nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
  if ! command -v submux >/dev/null 2>&1; then
    echo "submux-claude: no 'submux' binary on PATH; build it with 'go build -o /path/on/PATH/submux .' first" >&2
    exit 1
  fi
  nohup submux serve --listen "127.0.0.1:$PORT" >>"$LOG_FILE" 2>&1 &

  waited=0
  until nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; do
    if [ "$waited" -ge 3000 ]; then
      echo "submux-claude: submux serve did not come up on port $PORT within 3s; see $LOG_FILE" >&2
      exit 1
    fi
    sleep 0.1
    waited=$((waited + 100))
  done
fi

# Step 3
export ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT"
# A custom base URL turns off deferred tool loading, so every MCP/deferred tool schema
# ships on every request (~108k vs ~27k tokens for a bare prompt). Force it back on.
export ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-true}"
# Tool input streaming is also off by default on gateways; Kiro handles it (tested).
export CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING="${CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING:-1}"

# Step 4: only export a tier's vars if an id was actually given for it.
if [ -n "$FABLE_ID" ]; then
  export ANTHROPIC_DEFAULT_FABLE_MODEL="$FABLE_ID"
  export ANTHROPIC_DEFAULT_FABLE_MODEL_NAME="$FABLE_ID"
fi
if [ -n "$OPUS_ID" ]; then
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$OPUS_ID"
  export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="$OPUS_ID"
fi
if [ -n "$SONNET_ID" ]; then
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$SONNET_ID"
  export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME="$SONNET_ID"
fi
if [ -n "$HAIKU_ID" ]; then
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$HAIKU_ID"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME="$HAIKU_ID"
fi

# Step 5
EXTRA=""
[ -n "$MAIN_ID" ] && EXTRA="$EXTRA --model $MAIN_ID"
[ -n "$EFFORT" ]  && EXTRA="$EXTRA --effort $EFFORT"
# Unquoted $EXTRA is intentional and safe: values are picked from fixed enum or model id
# shellcheck disable=SC2086
exec claude $EXTRA "$@"
